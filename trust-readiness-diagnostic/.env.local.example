# Agent Trust Readiness Diagnostic - Environment Configuration Example

# Gumroad Low-Friction Payment Surface URLs
NEXT_PUBLIC_GUMROAD_REPORT_URL="https://hillarynjuguna.gumroad.com/l/agent-trust-readiness-report"
NEXT_PUBLIC_GUMROAD_EXPERT_URL="https://hillarynjuguna.gumroad.com/l/founder-trust-review"

# Gumroad Product IDs
GUMROAD_REPORT_PRODUCT_ID="uazesx"
GUMROAD_REVIEW_PRODUCT_ID="hd8oOeH9NheiiQ_v6RFBGQ=="

# Required before exposing the admin dashboard or Gumroad ping route
ADMIN_ACCESS_TOKEN="replace_with_random_admin_token"
GUMROAD_PING_SECRET="replace_with_random_ping_secret"

# Storage mode: "file" (local dev), "kv" (production Vercel KV), or "memory" (tests)
# Use "kv" for production to ensure data persists across serverless function invocations.
REPORT_STORE_MODE="kv"

# Beehiiv ESP Integration (Automated Email Nurture Sync)
BEEHIIV_API_KEY="your_beehiiv_api_key_here"
BEEHIIV_PUBLICATION_ID="pub_your_publication_id_here"

# Future / Optional Scaffolding (Dormant in Current Gumroad MVP Phase)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
